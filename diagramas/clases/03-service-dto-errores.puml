@startuml 03-service-dto-errores
!include estilo.iuml
title KindBox - Backend: service.dto y service.error (contratos de la API)

package "service.dto" {
  class SolicitudSimulacion <<record>> {
    tipo : TipoEscenario
    primerDia : LocalDate
    ultimoDia : LocalDate
    duracionMinutosReales : Integer
    saltoMinutos : Integer
    minutosEntreFotografias : Integer
    algoritmo : String
    semilla : Long
    generarAverias : Boolean
  }
  class ResumenCorrida <<record>> {
    id : String
    tipo : TipoEscenario
    algoritmo : String
    estado : EstadoCorrida
    primerDia / ultimoDia : LocalDate
    minutoSimulado : long
    fechaHoraSimulada : LocalDateTime
    pedidosDelEscenario : int
    unidadesDeLaFlota : int
    productosEntregados : int
    ...
    + avance() : double
  }
  class DetalleCorrida <<record>> {
    corrida : ResumenCorrida
    instantanea : InstantaneaSimulacion
    resultado : ResultadoSimulacion
    averias : List<String>
  }
  class PaginaPedidos <<record>> {
    filas : List<FilaPedido>
    pagina : int
    tamano : int
    totalFilas : int
    totalPaginas : int
    busqueda : String
    soloActivos : boolean
  }
  class FilaPedido <<record>> {
    id : int
    cliente : String
    paquetes : int
    pendientes : int
    x, y : int
    plazoHoras : int
    registro / limite : LocalDateTime
    holguraMinutos : long
    entregado : boolean
    semaforo : ColorSemaforo
  }
  class SolicitudAveria <<record>> {
    placa : String
    tipo : Integer
  }
  class RespuestaAveria <<record>> {
    placa : String
    tipo : int
    minutoSimulado : long
    fechaHoraSimulada : LocalDateTime
    minutoReincorporacion : long
    mensaje : String
  }
  class ResultadoCargaAverias <<record>> {
    leidas : int
    aplicadas : int
    programadas : int
    avisos : List<String>
  }
  class SolicitudVelocidad <<record>> {
    tipo : String
    kmPorHora : Double
  }
  class SolicitudSemaforo <<record>> {
    ambar : Integer
    verde : Integer
  }
  class VistaParametros <<record>> {
    velocidades : Map<String, Double>
    tipos : List<FichaTipoUnidad>
    umbralSemaforoAmbar : int
    umbralSemaforoVerde : int
    minutosAcondicionamiento : int
    minutosAlimentacion : int
    minutosTrasvase : int
    version : long
  }
  class FichaTipoUnidad <<record>> {
    tipo : String
    prefijo : String
    capacidad : int
    velocidadVigente : double
    costoPorKm : double
  }
  class RespuestaSalud <<record>> {
    estado : String
    instante : Instant
    datosDisponibles : boolean
    motor : String
    algoritmos : List<String>
    corridaActiva : String
    clientesConectados : int
  }
  class MensajeVisualizador <<record>> {
    tipo : String
    corrida : String
    carga : Object
  }
  class RespuestaError <<record>> {
    codigo : int
    codigoError : String
    tipo : String
    error : String
    mensaje : String
    ruta : String
    instante : Instant
  }
}

package "service.error" {
  class RuntimeException <<Java>>
  class RecursoNoEncontrado
  class ConflictoDeEstado
  class SolicitudInvalida
  class ErrorDeDatos
}

package "core.simulacion (ver 05-simulacion)" #EEEEEE {
  class InstantaneaSimulacion
  class ResultadoSimulacion
  enum TipoEscenario
  enum EstadoCorrida
  enum ColorSemaforo
}

DetalleCorrida *-- ResumenCorrida : corrida
DetalleCorrida --> InstantaneaSimulacion
DetalleCorrida --> ResultadoSimulacion
PaginaPedidos *-- "0..*" FilaPedido : filas
VistaParametros *-- "3" FichaTipoUnidad : tipos
SolicitudSimulacion --> TipoEscenario
ResumenCorrida --> TipoEscenario
ResumenCorrida --> EstadoCorrida
FilaPedido --> ColorSemaforo

RecursoNoEncontrado --|> RuntimeException
ConflictoDeEstado --|> RuntimeException
SolicitudInvalida --|> RuntimeException
ErrorDeDatos --|> RuntimeException
note bottom of RuntimeException
  ManejadorDeErrores traduce cada excepcion a RespuestaError:
  RecursoNoEncontrado -> 404, ConflictoDeEstado -> 409,
  SolicitudInvalida -> 400, ErrorDeDatos -> 500
end note

SolicitudAveria -[hidden]down- RespuestaAveria
SolicitudVelocidad -[hidden]down- SolicitudSemaforo
RespuestaSalud -[hidden]down- MensajeVisualizador
MensajeVisualizador -[hidden]down- RespuestaError
@enduml
