@startuml 1-vista-general
!include estilo.iuml
allowmixing
hide members
title 1. Vista general: clases principales por componente

package "API REST" as P_API {
  class ControladorReportes <<nuevo>>
  class ControladorSimulaciones <<modificar>>
  class ControladorArchivos <<nuevo>>
}
package "Servicios de negocio" as P_SRV {
  class ServicioSimulacion <<modificar>>
  class ServicioPedidos <<nuevo>>
  class ServicioImportacion <<nuevo>>
  class ServicioReportes <<nuevo>>
}
package "Ingesta y diario de comandos" as P_ING {
  class IngestaComandos <<nuevo>>
  class DiarioComandos <<nuevo>>
  abstract class Comando <<nuevo>>
}
package "Gestion de contextos" as P_CTX {
  class GestorContextos <<nuevo>>
  class Corrida <<modificar>>
}
package "Motor de simulacion" as P_MOT {
  class MotorSimulacion <<modificar>>
}
package "Difusion en tiempo real" as P_DIF {
  class DifusorInstantaneas
}
package "Planificador" as P_PLA {
  interface Algoritmo
}
package "Persistencia" as P_PER {
  interface RepositorioCorridas <<nuevo>>
  interface RepositorioPuntosControl <<nuevo>>
  interface RepositorioDiario <<nuevo>>
}
package "Lectura de archivos" as P_ARC {
  class RepositorioDatos <<modificar>>
}

database "Base de datos\nMySQL" as BD
folder "Archivos de\nentrada" as AR

ControladorSimulaciones --> ServicioSimulacion
ControladorSimulaciones --> ServicioPedidos
ControladorArchivos --> ServicioImportacion
ControladorReportes --> ServicioReportes
ServicioReportes --> RepositorioCorridas : lee
DiarioComandos --> RepositorioDiario : escribe
ServicioPedidos --> IngestaComandos : registra comandos
ServicioSimulacion --> GestorContextos
ServicioImportacion --> RepositorioDatos
IngestaComandos --> DiarioComandos
IngestaComandos ..> Comando
IngestaComandos --> MotorSimulacion : entrega comandos
GestorContextos "1" *-- "0..*" Corrida
Corrida --> MotorSimulacion
GestorContextos ..> MotorSimulacion : crea
MotorSimulacion ..> GestorContextos : notifica cierre de dia
MotorSimulacion ..> DifusorInstantaneas : publica instantaneas
MotorSimulacion --> Algoritmo : solicita planes
GestorContextos --> RepositorioCorridas
GestorContextos --> RepositorioPuntosControl
GestorContextos --> RepositorioDatos : lee escenario
RepositorioCorridas ..> BD
RepositorioPuntosControl ..> BD
RepositorioDiario ..> BD
RepositorioDatos ..> AR

!include leyenda.iuml
@enduml
