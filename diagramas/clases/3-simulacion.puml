@startuml 3-simulacion
!include estilo.iuml
title 3. Simulacion: motor dirigido por eventos

class MotorSimulacion {
  - configuracion : ConfiguracionEscenario
  - algoritmo : Algoritmo
  - observadores : List<ObservadorSimulacion>
  + ejecutar() : ResultadoSimulacion
  + cancelar() : void
  + instantanea() : InstantaneaSimulacion
  + registrarAveria(codigoUnidad, tipo) : void
}

class ConfiguracionEscenario <<record>> {
  tipo : TipoEscenario
  primerDia : LocalDate
  ultimoDia : LocalDate
  saltoMinutos : int
  algoritmo : String
}

class EstadoSimulacion {
  - pedidos : List<Pedido>
  - almacenes : List<Almacen>
  + entregar(pedido, cantidad, minuto) : boolean
  + consumirInventario(almacen, cantidad) : int
  + metricas() : MetricasSimulacion
}

class UnidadEnCurso {
  - ruta : Ruta
  - averia : TipoAveria
  + asignarItinerario(ruta, ...) : void
  + nodoActual(minuto) : int
}

class ColaEventos {
  + programar(minuto, tipo) : Evento
  + siguiente() : Evento
}

class Evento <<record>> {
  minuto : long
  tipo : TipoEvento
}

class GeneradorAverias {
  + averiasDelTurno(minuto, unidades) : List<Averia>
}

class InstantaneaSimulacion <<record>> {
  minutoSimulado : long
  unidades : List<VistaUnidad>
  almacenes : List<VistaAlmacen>
  metricas : MetricasSimulacion
}

class ResultadoSimulacion <<record>> {
  estado : EstadoCorrida
  minutoFinal : long
  metricas : MetricasSimulacion
}

interface ObservadorSimulacion
interface Algoritmo
class UnidadTransporte
class DatosEscenario <<record>> {
  pedidos : List<Pedido>
  bloqueos : List<Bloqueo>
  flota : FlotaLeida
}

MotorSimulacion --> ConfiguracionEscenario
MotorSimulacion "1" *-- "1" EstadoSimulacion
MotorSimulacion "1" *-- "1" ColaEventos
MotorSimulacion *-- GeneradorAverias
MotorSimulacion --> Algoritmo : replanifica
MotorSimulacion o-- "0..*" ObservadorSimulacion : notifica
MotorSimulacion --> DatosEscenario : datos de entrada
MotorSimulacion ..> InstantaneaSimulacion : genera
MotorSimulacion ..> ResultadoSimulacion : genera
EstadoSimulacion "1" *-- "1..*" UnidadEnCurso
UnidadEnCurso --> UnidadTransporte
ColaEventos "1" *-- "0..*" Evento
@enduml
