' Estilo comun de los diagramas de clases de KindBox
set separator none
skinparam dpi 110
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam class {
  BackgroundColor #FDFDFD
  BorderColor #4A5A6A
  ArrowColor #4A5A6A
  HeaderBackgroundColor #E8EEF4
  BackgroundColor<<nuevo>> #DFF3DC
  BorderColor<<nuevo>> #2E7D32
  BackgroundColor<<modificar>> #FFF1CC
  BorderColor<<modificar>> #B7791F
}
skinparam package {
  BackgroundColor #F6F8FA
  BorderColor #8A9AAA
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #C8B560
}
hide empty members
hide <<nuevo>> stereotype
hide <<modificar>> stereotype
