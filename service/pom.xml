<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.kindbox</groupId>
        <artifactId>metaheuristics-platform</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>org.kindbox.service</groupId>
    <artifactId>service</artifactId>
    <name>KindBox Service</name>
    <description>API REST y WebSocket que alimenta el componente visualizador</description>

    <dependencies>
        <dependency>
            <groupId>org.kindbox.core</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Spring resuelve por nombre los argumentos de los controladores. El
                         proyecto no hereda de spring-boot-starter-parent, de modo que la
                         marca -parameters hay que pedirla aqui. Las anotaciones tambien
                         llevan el nombre explicito, que es la garantia que no depende de
                         como se compile. -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <!-- El directorio de datos por defecto es "data", que cuelga de la raiz
                         del proyecto y no del modulo, de modo que spring-boot:run debe
                         arrancar desde la raiz para resolverlo. -->
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                </configuration>
                <executions>
                    <execution><goals><goal>repackage</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
